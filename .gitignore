node_modules/
dist/
ui-dist/
# `*.log` 也覆盖**根目录的点号日志**（`.onboard-err.log` 之类；gitignore 的 `*` 会匹配点号开头）
# —— 别把它收窄成 `/logs/`：那会让调试残留重新入库，而它们正是最容易被误提交的那类文件。
*.log
.worktrees/
.workbuddy/
output/

# License 签发材料
vendor-keys/
/out/
/license.json
activation-request*.json

# 本机运行态配置：含真实 API Key / 微信库路径 / 解密密钥，绝不入库
# （模板见 wechat/*.example.json）
wechat/config.json
wechat/llm.json

# 构建与调试残留
.tmp-*
*.orig
*.tsbuildinfo
# 导出/写盘的原子落地临时文件（正常会被 rename 或删除，异常中断时才会残留）
*.partial-*

# 本机调试残留整目录：CDP 探针脚本与截图（含真实联系人文案）、验收输出、临时 txt。
# 只忽略 `working/shots/` 时，同级的 *.png / *.mjs 仍是未忽略的 `?? working/`，
# 一次 `git add -A` 就会把明文截图扫进仓库。仓库内无任何代码以此为输入。
working/
