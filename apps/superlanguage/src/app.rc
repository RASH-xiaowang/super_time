#include "version.h"
#include "resource.h"

IDI_APP ICON "assets/app.ico"

1 24 "assets/app.manifest"

1 VERSIONINFO
FILEVERSION FEATHER_VERSION_NUMERIC
PRODUCTVERSION FEATHER_VERSION_NUMERIC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SuperLanguage"
            VALUE "FileDescription", "SuperLanguage · 微信消息自动化"
            VALUE "FileVersion", FEATHER_VERSION_STRING
            VALUE "InternalName", "SuperLanguage"
            VALUE "OriginalFilename", "SuperLanguage.exe"
            VALUE "ProductName", "SuperLanguage"
            VALUE "ProductVersion", FEATHER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
