# Normalize text files in the repository by default.
* text=auto

# Windows command scripts keep CRLF on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and documentation use LF.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.rc text eol=lf
*.py text eol=lf
*.md text eol=lf
*.manifest text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Existing release manifests are CRLF and are checksum-bearing artifacts.
*.json text eol=crlf

# Never line-convert binary assets.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.webp binary
*.pdf binary
*.zip binary
*.exe binary
