{
  "name": "@deepseek-ai/dsh-client-ui-wechat",
  "description": "Super Time (WeChat data dashboard): renders decrypted local WeChat data via the dsh-wechat-data Remote gateway (panels adapted into the current client runtime)",
  "version": "1.0.7",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/client/contracts.ts",
      "default": "./src/client/contracts.ts"
    },
    "./host": {
      "types": "./src/client/public/host.ts",
      "default": "./src/client/public/host.ts"
    },
    "./notice": {
      "types": "./src/client/public/notice.tsx",
      "default": "./src/client/public/notice.tsx"
    },
    "./theme": {
      "types": "./src/client/public/theme.ts",
      "default": "./src/client/public/theme.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.0.0",
    "echarts": "^6.1.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "src/**/*",
    "tsconfig.json"
  ]
}
