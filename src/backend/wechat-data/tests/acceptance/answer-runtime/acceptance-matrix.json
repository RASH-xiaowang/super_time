{
  "version": 2,
  "updatedAt": "2026-10-22",
  "statusSemantics": {
    "requestStatus": {
      "meaning": "请求进入工具循环前的安全门禁。accepted 只表示未被 profile、会话范围或来源约束拒绝，不表示最终有答案。",
      "values": ["accepted", "blocked"]
    },
    "answerStatus": {
      "meaning": "请求被接受且仍有可用证据时的最终回答状态；没有可用证据时以 fallbackStatus 为准。每格用 statusSelector 明确采用哪一个。",
      "values": ["ok", "degraded", "insufficient", "needs_clarification", "failed", "blocked"]
    },
    "fallbackStatus": {
      "meaning": "没有可用证据或只能返回兜底文本时的最终回答状态；null 表示该异常不允许兜底。",
      "values": ["ok", "degraded", "insufficient", "needs_clarification", "failed", "blocked", null]
    }
  },
  "thresholdEvaluation": {
    "status": "not-measured",
    "note": "阈值已定义，但仓库尚无固定评测集和评测脚本；定向单测通过不等于质量阈值已达成。"
  },
