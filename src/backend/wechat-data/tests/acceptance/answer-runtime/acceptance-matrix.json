  "knownRuntimeGaps": [
    {
      "id": "llm-intent-gain-unmeasured",
      "kind": "test-sync",
      "profiles": ["wechat-ask", "session-ask", "clawbot-auto"],
      "anomalies": ["invalid_arguments"],
      "currentObserved": "低置信/澄清时已接入 LLM 意图复核，并有 4 秒独立 deadline、返回形状校验与规则回退；但尚未用固定评测集证明相对纯规则的准确率增益。",
      "target": {
        "requestStatus": "accepted",
        "answerStatus": "needs_clarification",
        "fallbackStatus": null
      },
      "expectedApi": "用三个 profile 的分层问题集对比规则与规则+LLM 复核的意图准确率和澄清率；LLM 只能细化意图，不能绕过 profile 白名单或范围守卫，超时/异常/非法返回必须回退规则。",
      "assertionFields": ["requestStatus", "finalStatus"]
    },
    {
      "id": "quality-thresholds-not-measured",
      "kind": "test-sync",
      "profiles": ["wechat-ask", "session-ask", "clawbot-auto"],
      "anomalies": ["empty"],
      "currentObserved": "Recall@20、MRR、意图准确率、工具 Top-1、指代消解与 p95 仅有门槛，仓库尚无固定评测集和实测结果。",
      "target": {
        "requestStatus": "accepted",
        "answerStatus": "insufficient",
        "fallbackStatus": null
      },
      "expectedApi": "建立三个 profile 的分层问题集与评测脚本，保留基线、变更后结果和失败样本；未跑通前不得宣称阈值已达成。",
      "assertionFields": ["requestStatus", "finalStatus"]
    },
    {
      "id": "tool-signal-adoption",
      "kind": "runtime",
      "profiles": ["wechat-ask", "session-ask", "clawbot-auto"],
      "anomalies": ["tool_timeout"],
      "currentObserved": "运行时已把 AbortSignal 注入 ToolContext，并在单次 deadline 触发时 abort；多数底层检索工具尚未主动检查 ctx.signal。",
      "target": {
        "requestStatus": "accepted",
        "answerStatus": "degraded",
        "fallbackStatus": "failed"
      },
      "expectedApi": "逐工具把 ctx.signal 传入数据库/网络调用，deadline 后尽快停止 I/O；无论工具是否响应 signal，运行时都保持超时结果与有界重试。",
      "assertionFields": ["requestStatus", "toolCalls[].deadlineExceeded", "finalStatus"]
    }
  ]
