  "anomalies": {
    "empty": {
      "meaning": "工具正常执行但没有任何命中或事实",
      "requestStatus": "accepted",
      "answerStatus": "insufficient",
      "fallbackStatus": null,
      "expectedEvidenceState": "missing",
      "statusRule": "纯空结果必须是 insufficient；不得把“没有命中”说成 blocked、failed 或 degraded。",
      "mustNotBeStatuses": ["ok", "blocked", "failed", "degraded"]
    },
    "tool_error": {
      "meaning": "工具返回结构化失败或上层异常被捕获",
      "requestStatus": "accepted",
      "answerStatus": "degraded",
      "fallbackStatus": "failed",
      "expectedEvidenceState": "partial-or-missing",
      "expectedErrorClass": "internal",
      "statusRule": "仍有可用证据时 answerStatus=degraded；工具全部失败且没有可用证据时必须取 fallbackStatus=failed。",
      "mustNotBeStatuses": ["ok", "insufficient"]
    },
    "tool_timeout": {
      "meaning": "工具执行超过运行时截止时间",
      "requestStatus": "accepted",
      "answerStatus": "degraded",
      "fallbackStatus": "failed",
      "expectedEvidenceState": "partial-or-missing",
      "expectedErrorClass": "timeout",
      "statusRule": "仍有可用证据时 answerStatus=degraded；工具全部失败且没有可用证据时必须取 fallbackStatus=failed。",
      "mustNotBeStatuses": ["ok", "insufficient"]
    },
    "scope_violation": {
      "meaning": "请求越过 profile 的数据面或当前会话硬范围",
      "requestStatus": "blocked",
      "answerStatus": "blocked",
      "fallbackStatus": null,
      "expectedEvidenceState": "missing",
      "expectedToolErrorCode": "scope_violation",
      "statusRule": "会话/来源拒绝必须收敛为 blocked；不得降级成普通工具失败或空结果。",
      "mustNotBeStatuses": ["ok", "degraded", "insufficient", "failed"]
    },
    "invalid_arguments": {
      "meaning": "工具参数缺必填项、类型错误或无法归一化",
      "requestStatus": "accepted",
      "answerStatus": "needs_clarification",
      "fallbackStatus": null,
      "expectedEvidenceState": "missing",
      "expectedToolErrorCode": "invalid_arguments",
      "statusRule": "参数无法安全归一化时要求澄清；不得执行空查询或返回 blocked。",
      "mustNotBeStatuses": ["ok", "blocked", "failed"]
    },
    "malformed_result": {
      "meaning": "工具返回成功形状但 hits/facts 不是可消费的稳定结构",
      "requestStatus": "accepted",
      "answerStatus": "degraded",
      "fallbackStatus": "failed",
      "expectedEvidenceState": "partial-or-missing",
      "expectedErrorClass": "internal",
      "statusRule": "仍有可用证据时 answerStatus=degraded；畸形结果且没有可用证据时必须取 fallbackStatus=failed。",
      "mustNotBeStatuses": ["ok", "insufficient"]
    }
  },
