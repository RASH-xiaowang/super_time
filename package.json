{
  "name": "super-time-electron",
  "version": "1.0.0",
  "description": "Electron desktop demo app with 微信+ backend/frontend migrated from @deepseek-ai/dsh-wechat-data",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npm run build:ui && electron .",
    "prestart": "npm run build:ui",
    "build:ui": "node scripts/sync-ui-shim.js && vite build",
    "sync:wechat": "node scripts/sync-wechat-bundle.js",
    "check:bundle": "node scripts/sync-wechat-bundle.js --check",
    "check:shim": "node scripts/sync-ui-shim.js --check",
    "check:button": "node scripts/check-button-variants.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "smoke:wechat": "node scripts/smoke-wechat.js",
    "check:sqlite": "node scripts/check-sqlite-page-cache.js",
    "check:contacts": "node scripts/check-contact-categories.js",
    "check:message": "node scripts/check-message-resolve.js",
    "check:message-model": "node scripts/check-message-model.js",
    "check:message-items": "node scripts/check-message-items.js",
    "check:appmsg": "node scripts/check-appmsg-subtypes.js",
    "check:paging": "node scripts/check-paging.js",
    "check:sender": "node scripts/check-sender-space.js",
    "check:ui": "node scripts/check-ui-consistency.js",
    "check:sns": "node scripts/check-sns-images.js 200",
    "check:ledger": "node scripts/check-ledger.js",
    "check:records": "node scripts/check-records.js",
    "check:media-assets": "node scripts/check-media-assets.js",
    "check:group-insights": "node scripts/check-group-insights.js",
    "check:records-default": "node scripts/st-cdp.js --file scripts/st-verify-records-default.js",
    "check:storage": "node scripts/check-storage.js",
    "check:sql": "node scripts/check-sql-columns.js",
    "check:int64": "node scripts/check-int64-safety.js",
    "check:insights": "node scripts/check-insights.js",
    "check:emoticons": "node scripts/check-emoticons.js",
    "check:avatars": "node scripts/check-avatar-labels.js",
    "check:favorites": "node scripts/check-favorites.js",
    "check:calls": "node scripts/check-calls.js",
    "check:solitaire": "node scripts/check-solitaire.js",
    "check:quote": "node scripts/check-quote.js",
    "check:focus": "node scripts/check-focus.js",
    "check:map": "node scripts/check-moments-map.js",
    "check:privacy": "node scripts/check-privacy.js",
    "check:privacy-audit-ui": "node scripts/check-privacy-audit-ui.js",
    "check:group-default": "node scripts/st-cdp.js --file scripts/st-verify-group-default.js",
    "check:panel-content": "node scripts/check-panel-content.js",
    "check:empty-note": "node scripts/st-cdp.js --file scripts/st-verify-empty-sync-note.js",
    "check:annual-cache": "node scripts/st-cdp.js --file scripts/st-verify-annual-cache.js",
    "audit:panel-growth": "node scripts/st-cdp.js --file scripts/st-verify-panel-growth.js",
    "audit:avatars": "node scripts/st-cdp.js --file scripts/st-verify-avatar-labels.js",
    "audit:map-geometry": "node scripts/st-cdp.js --file scripts/st-verify-map-geometry.js",
    "analyze:avatar-layout": "node scripts/analyze-avatar-label-layout.js",
    "shots": "node scripts/st-shots.js",
    "png:map": "node scripts/png-map.js",
    "check:display": "node scripts/check-display-text.js",
    "check:css": "node scripts/audit-css-usage.js",
    "check:text": "node scripts/audit-text-utilities.js",
    "audit:a11y": "node scripts/audit-a11y-clickable.js",
    "audit:truncation": "node scripts/st-cdp.js --file scripts/st-truncation-sweep.js",
    "audit:contrast": "node scripts/st-cdp.js --file scripts/st-contrast-sweep.js",
    "audit:header": "node scripts/st-cdp.js --file scripts/st-header-sweep.js",
    "audit:cap": "node scripts/audit-cap-aggregate.js",
    "audit:tables": "node scripts/audit-unused-tables.js",
    "audit:scale": "node scripts/audit-visual-scale.js",
    "check:announce-time": "node scripts/check-announce-time.js",
    "check:unread-since": "node scripts/check-unread-since.js",
    "check:search-esc": "node scripts/st-cdp.js --file scripts/st-verify-search-esc.js",
    "audit:interactions": "node scripts/st-cdp.js --file scripts/st-verify-interaction-census.js",
    "audit:packed": "node scripts/audit-packed-info.js",
    "verify:all": "node scripts/verify-all.js",
    "audit:condcols": "node scripts/audit-conditional-columns.js",
    "audit:drift": "node scripts/audit-bundle-drift.js",
    "audit:direction": "node scripts/audit-message-direction.js",
    "config:wechat": "node scripts/wechat-config.js",
    "check:chrome": "node scripts/st-cdp.js --file scripts/st-verify-panel-chrome.js",
    "check:empty-states": "node scripts/st-cdp.js --file scripts/st-verify-empty-states.js",
    "check:align": "node scripts/st-cdp.js --file scripts/st-verify-align.js",
    "check:surface": "node scripts/st-cdp.js --file scripts/st-verify-theme-surface.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:files-cats": "node scripts/check-files-categories.js",
    "check:files-source": "node scripts/check-files-source.js",
    "check:files-ui": "node scripts/st-cdp.js --file scripts/st-verify-files-cats.js",
    "check:api-cache": "node scripts/check-api-cache-keys.js",
    "check:contacts-pinyin": "node scripts/check-contacts-pinyin.js",
    "audit:dead-remote": "node scripts/audit-dead-remote.js",
    "check:inline-colors": "node scripts/check-inline-colors.js",
    "check:inline-layout": "node scripts/check-inline-layout.js",
    "check:avatar-contrast": "node scripts/check-avatar-contrast.js",
    "check:backup-preview": "node scripts/check-backup-preview.js",
    "check:shortcuts": "node scripts/check-shortcuts.js",
    "check:members-search": "node scripts/check-members-search.js",
    "check:responsive": "node scripts/check-responsive.js",
    "check:react-keys": "node scripts/st-cdp.js --file scripts/st-verify-react-keys.js",
    "check:msg-render": "node scripts/st-cdp.js --file scripts/st-verify-msg-render.js"
  },
  "keywords": [
    "electron",
    "desktop",
    "wechat",
    "demo"
  ],
  "author": "Super Time",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "file:src/backend/deps/cordis",
    "@deepseek-ai/cosmokit": "file:src/backend/deps/cosmokit",
    "@deepseek-ai/dsh-brand": "file:src/backend/deps/dsh-brand",
    "@deepseek-ai/dsh-home-paths": "file:src/backend/deps/dsh-home-paths",
    "@deepseek-ai/dsh-invariants": "file:src/backend/deps/dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:src/backend/deps/dsh-llm",
    "@deepseek-ai/dsh-native-command": "file:src/backend/deps/dsh-native-command",
    "@deepseek-ai/dsh-timeout": "file:src/backend/deps/dsh-timeout",
    "@deepseek-ai/dsh-typert-protocol": "file:src/backend/deps/dsh-typert-protocol",
    "@deepseek-ai/dsh-util-crypto": "file:src/backend/deps/dsh-util-crypto",
    "@deepseek-ai/dsh-util-values": "file:src/backend/deps/dsh-util-values",
    "@deepseek-ai/schemastery": "file:src/backend/deps/schemastery",
    "@standard-schema/spec": "file:src/backend/deps/@standard-schema/spec",
    "fzstd": "file:src/backend/deps/fzstd",
    "koffi": "file:src/backend/deps/koffi",
    "unzipper": "^0.12.5",
    "zod": "file:src/backend/deps/zod"
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-x64": "file:src/backend/deps/@koromix/koffi-win32-x64"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "@deepseek-ai/dsh-client-ui-primitives": "file:src/client/ui-primitives-shim",
    "@deepseek-ai/dsh-wechat-data": "file:src/backend/wechat-data",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "echarts": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.supertime.electron",
    "productName": "Super Time",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "wechat/**/*",
      "node_modules/@deepseek-ai/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/@standard-schema/**/*",
      "node_modules/fzstd/**/*",
      "node_modules/koffi/**/*",
      "node_modules/unzipper/**/*",
      "node_modules/zod/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "wechat/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
