{
  "name": "super-time-electron",
  "version": "1.0.0",
  "description": "Electron desktop demo app with 微信+ backend/frontend migrated from @deepseek-ai/dsh-wechat-data（仅支持 Windows x64）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npm run build:ui && npm run build:backend && electron .",
    "prestart": "npm run build:ui && npm run build:backend",
    "build:ui": "node scripts/sync-ui-shim.js && vite build",
    "build:backend": "node scripts/build-wechat-bundle.js",
    "build:types": "tsc -p src/backend/wechat-data/tsconfig.types.json",
    "typecheck:server": "tsc -p src/backend/wechat-data/tsconfig.json --noEmit",
    "typecheck:client": "tsc -p src/client/ui-wechat/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "security-guard:smoke": "node scripts/security-guard-smoke.js",
    "security-guard:smoke:packaged": "node scripts/security-guard-smoke.js --packaged",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:shim": "node scripts/sync-ui-shim.js --check",
    "check:wx-tokens": "node scripts/check-wx-tokens.js",
    "rag:check": "node scripts/rag-retrieval-check.js",
    "check:whisper-paths": "node scripts/whisper-paths-check.js",
    "check:sns-video": "node scripts/sns-video-check.js",
    "check:knowledge-graph": "node scripts/knowledge-graph-smoke.js",
    "check:backend-restart": "node scripts/backend-restart-smoke.js",
    "license-gate:smoke": "node scripts/license-gate-smoke.js",
    "rag:smoke": "node scripts/rag-smoke.js",
    "ui:smoke": "node scripts/ui-ask-smoke.js",
    "ui:accept": "node scripts/ui-acceptance.mjs",
    "package:smoke": "node scripts/packaged-smoke.js",
    "m1-secrets:smoke": "node scripts/m1-secrets-migration-smoke.js",
    "epipe:smoke": "node scripts/epipe-smoke.js",
    "pack": "npm run build:ui && electron-builder --dir",
    "dist": "npm run build:ui && electron-builder --win nsis",
    "license-studio": "electron tools/license-studio",
    "license-keygen": "node scripts/license-keygen.js",
    "license-issue": "node scripts/license-issue.js",
    "license-smoke": "node scripts/license-smoke.js"
  },
  "keywords": [
    "electron",
    "desktop",
    "wechat",
    "demo"
  ],
  "author": "Super Time",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "file:src/backend/deps/cordis",
    "@deepseek-ai/cosmokit": "file:src/backend/deps/cosmokit",
    "@deepseek-ai/dsh-brand": "file:src/backend/deps/dsh-brand",
    "@deepseek-ai/dsh-home-paths": "file:src/backend/deps/dsh-home-paths",
    "@deepseek-ai/dsh-invariants": "file:src/backend/deps/dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:src/backend/deps/dsh-llm",
    "@deepseek-ai/dsh-native-command": "file:src/backend/deps/dsh-native-command",
    "@deepseek-ai/dsh-timeout": "file:src/backend/deps/dsh-timeout",
    "@deepseek-ai/dsh-typert-protocol": "file:src/backend/deps/dsh-typert-protocol",
    "@deepseek-ai/dsh-util-crypto": "file:src/backend/deps/dsh-util-crypto",
    "@deepseek-ai/dsh-util-values": "file:src/backend/deps/dsh-util-values",
    "@deepseek-ai/schemastery": "file:src/backend/deps/schemastery",
    "@standard-schema/spec": "file:src/backend/deps/@standard-schema/spec",
    "fzstd": "file:src/backend/deps/fzstd",
    "koffi": "file:src/backend/deps/koffi",
    "unzipper": "^0.12.5",
    "zod": "file:src/backend/deps/zod"
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-x64": "file:src/backend/deps/@koromix/koffi-win32-x64"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "file:src/client/ui-primitives-shim",
    "@deepseek-ai/dsh-wechat-data": "file:src/backend/wechat-data",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.20.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "echarts": "^6.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "5.7",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.supertime.electron",
    "productName": "Super Time",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/backend/deps/**",
      "!src/**/*.ts",
      "!src/client/ui-app/**",
      "wechat/**/*",
      "!wechat/*.json",
      "node_modules/@deepseek-ai/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/@standard-schema/**/*",
      "node_modules/fzstd/**/*",
      "node_modules/koffi/**/*",
      "node_modules/unzipper/**/*",
      "node_modules/zod/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "src/backend/wechat-data/native/**",
      "src/backend/wechat-data/resources/**",
      "wechat/README.md",
      "wechat/whisper/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
